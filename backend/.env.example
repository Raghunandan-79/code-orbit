# Syncraft Backend Configuration Environment Variables

# Network & Server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
GRACEFUL_SHUTDOWN_TIMEOUT=10s

# Allowed Origins for CORS and WebSocket connections
# Use comma-separated list of origins, or * to permit all origins (development default)
ALLOWED_ORIGINS=*

# Capacity Limits
MAX_ROOMS=1000
MAX_PARTICIPANTS_PER_ROOM=25
MAX_WEBSOCKET_MESSAGE_SIZE=524288
MAX_BUFFERED_UPDATES_PER_ROOM=2000

# Room Lifecycle & Expiration
ROOM_IDLE_EXPIRATION=24h
ROOM_CLEANUP_INTERVAL=10m

# Security & Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=30
WS_MESSAGE_RATE_LIMIT=100

# WebSocket Heartbeats & Dead Connection Detection
WS_PING_INTERVAL=15s
WS_PING_TIMEOUT=5s

